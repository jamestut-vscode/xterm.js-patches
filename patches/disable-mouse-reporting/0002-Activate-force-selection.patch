From 76ab8286e08a72eafa30a99862d01025bd4a4027 Mon Sep 17 00:00:00 2001
From: James <aslan.jnn@gmail.com>
Date: Wed, 8 Jul 2026 00:00:00 +0000
Subject: Activate force selection when mouse reporting is disabled

---
 src/browser/services/SelectionService.ts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/browser/services/SelectionService.ts b/src/browser/services/SelectionService.ts
index 39d8dd76b..3184dd2ca 100644
--- a/src/browser/services/SelectionService.ts
+++ b/src/browser/services/SelectionService.ts
@@ -435,6 +435,10 @@ export class SelectionService extends Disposable implements ISelectionService {
    * @param event The mouse event.
    */
   public shouldForceSelection(event: MouseEvent): boolean {
+    if (!this._optionsService.rawOptions.allowMouseReporting) {
+      return true;
+    }
+
     if (this._optionsService.rawOptions.mouseEventsRequireAlt && this._mouseStateService.areMouseEventsActive) {
       return !event.altKey;
     }
