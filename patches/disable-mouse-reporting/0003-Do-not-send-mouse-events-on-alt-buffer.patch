From 26a154bac2ca25256ff1be07dd08a847c43fa462 Mon Sep 17 00:00:00 2001
From: James <aslan.jnn@gmail.com>
Date: Sat, 11 Apr 2026 11:36:52 +1000
Subject: Do not send mouse events on alt scrollback buffer when  mouse
 reporting is disabled

---
 src/browser/services/MouseService.ts | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/browser/services/MouseService.ts b/src/browser/services/MouseService.ts
index d701796c..5a58d964 100644
--- a/src/browser/services/MouseService.ts
+++ b/src/browser/services/MouseService.ts
@@ -261,8 +261,12 @@ export class MouseService implements IMouseService {
       }
 
       // Construct and send sequences
-      const sequence = C0.ESC + (this._coreService.decPrivateModes.applicationCursorKeys ? 'O' : '[') + (ev.deltaY < 0 ? 'A' : 'B');
-      this._coreService.triggerDataEvent(sequence, true);
+      if (this._optionsService.rawOptions.allowMouseReporting) {
+        const sequence = C0.ESC + (this._coreService.decPrivateModes.applicationCursorKeys ? 'O' : '[') + (ev.deltaY < 0 ? 'A' : 'B');
+        this._coreService.triggerDataEvent(sequence, true);
+      } else {
+        return;
+      }
       ev.preventDefault();
       ev.stopPropagation();
       return false;
-- 
