From cc3930b7d072488bbfa4f09f8bb822c0a098115f Mon Sep 17 00:00:00 2001
From: James <aslan.jnn@gmail.com>
Date: Sat, 11 Apr 2026 12:00:00 +1100
Subject: Disable all mouse protocols when mouse reporting is disabled

---
 src/browser/services/MouseService.ts | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/browser/services/MouseService.ts b/src/browser/services/MouseService.ts
index 5a58d964..7cbeb084 100644
--- a/src/browser/services/MouseService.ts
+++ b/src/browser/services/MouseService.ts
@@ -25,6 +25,7 @@ export class MouseService implements IMouseService {
   private _lastEvent: ICoreMouseEvent | null = null;
   private _wheelPartialScroll: number = 0;
   private _touchScrollAccumulator: number = 0;
+  private _activeMouseEvents: CoreMouseEventType = CoreMouseEventType.NONE;
 
   constructor(
     @IRenderService private readonly _renderService: IRenderService,
@@ -64,6 +65,15 @@ export class MouseService implements IMouseService {
       mousemove: (ev: Event) => this._handleMouseMove(ctx, ev as MouseEvent)
     };
     register(this._mouseStateService.onProtocolChange(events => {
+      this._activeMouseEvents = events;
+      if (!this._optionsService.rawOptions.allowMouseReporting) {
+        events = CoreMouseEventType.NONE;
+      }
+      this._handleProtocolChange(ctx, eventListeners, events);
+    }));
+    register(this._optionsService.onOptionChange(() => {
+      const events = this._optionsService.rawOptions.allowMouseReporting ?
+        this._activeMouseEvents : CoreMouseEventType.NONE;
       this._handleProtocolChange(ctx, eventListeners, events);
     }));
     // force initial onProtocolChange so we dont miss early mouse requests
-- 
